    "LEM": {
      "forced": false,
      "proof": "max(a, 1-a) = 0.5 for a=0.5, not 1"
    },
    "graded_truth": {
      "forced": true,
      "proof": "V=[0,1] continuous. Truth values are degrees."
    },
    "leibniz": {
      "forced": false
    },
    "FTC": {
      "forced": false
    }
  },
  "explicit_failures": [
    "Cannot make sharp categorical distinctions",
    "Sorites paradox: no crisp boundary between heap and non-heap"
  ],
  "falsification_test": "tests/test_carriers.py::test_fuzzy",
  "notes": "Gradients: neg(a)=1-a, and(a,b)=max(0,a+b-1), or(a,b)=min(1,a+b)"
}