{
  "name": "Lukasiewicz Fuzzy Logic",
  "version": "1.0",
  "author": "pugmire",
  "parameters": {
    "V": "[0, 1]",
    "Gamma": "lukasiewicz",
    "theta": 0.5
  },
  "forced_laws": {
    "LNC": {
      "forced": false,
      "proof": "min(a, 1-a) can be > 0 for a=0.5: min(0.5,0.5)=0.5"
